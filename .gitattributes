# Normalisation des fins de ligne (LF dans le dépôt)
* text=auto

# --- Code ---
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.compute   text
*.asmdef    text
*.json      text
*.md        text

# --- Fichiers YAML Unity (Force Text activé dans le projet) ---
# merge=unityyamlmerge : utilise Smart Merge si le driver est configuré (voir README),
# sinon Git utilise sa fusion classique.
*.unity       text eol=lf merge=unityyamlmerge linguist-generated
*.prefab      text eol=lf merge=unityyamlmerge linguist-generated
*.asset       text eol=lf merge=unityyamlmerge linguist-generated
*.mat         text eol=lf merge=unityyamlmerge linguist-generated
*.anim        text eol=lf merge=unityyamlmerge linguist-generated
*.controller  text eol=lf merge=unityyamlmerge linguist-generated
*.overrideController text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial text eol=lf merge=unityyamlmerge linguist-generated
*.meta        text eol=lf merge=unityyamlmerge linguist-generated
*.inputactions text eol=lf

# --- Binaires ---
# Git LFS n'est pas encore installé sur cette machine. Installer Git LFS avant d'ajouter
# des modèles, textures et sons, puis remplacer "binary" par
# "filter=lfs diff=lfs merge=lfs -text" sur les lignes ci-dessous.
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.tif  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.a    binary
*.aar  binary
*.jar  binary
graphify-out/graph.json merge=graphify
